{
  "expo": {
    "name": "İstanbul Kesinti",
    "slug": "istanbul-kesinti",
    "owner": "thequartz",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.xbabazibazi.istanbulkesinti",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12161C"
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF1F5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildFeatures": {
              "buildConfig": true
            }
          }
        }
      ],
      "./plugins/withFixAndroidPackage.js"
    ],
    "extra": {
      "eas": {
        "projectId": "6b692797-627c-4f8c-9978-04308163f92a"
      }
    }
  }
}
