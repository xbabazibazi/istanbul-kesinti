{
  "expo": {
    "name": "Kesinti",
    "slug": "istanbul-kesinti",
    "owner": "thequartz",
    "version": "1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.xbabazibazi.istanbulkesinti",
      "versionCode": 21,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12161C"
      }
    },
    "ios": {
      "bundleIdentifier": "com.xbabazibazi.istanbulkesinti",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEF1F5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildFeatures": {
              "buildConfig": true
            }
          }
        }
      ],
      "./plugins/withFixAndroidPackage.js",
      "./plugins/withReleaseSigning.js"
    ],
    "extra": {
      "eas": {
        "projectId": "6b692797-627c-4f8c-9978-04308163f92a"
      }
    }
  }
}
